generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  invoices     Invoice[]
  accounts     Account[]
  transactions Transaction[]
}

model Transaction {
  publicId        String         @default(uuid())
  id              Int            @id @default(autoincrement())
  transactionHash String?        @unique
  idempotencyKey  String?        @unique
  type            Type
  amount          BigInt
  createdAt       DateTime       @default(now())
  status          PossibleStatus @default(pending)
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  entries         LedgerEntry[]

  @@index([userId])
}

model Account {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  type      AccountType
  currency  String
  network   String
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  entries   LedgerEntry[]

  @@unique([userId, currency, network])
}

// checking movement details of the transaction , THE VIEW FROM USER/SYSTEM BALANCES
// => give strict understantion about all balance history
model LedgerEntry {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  transactionId Int
  accountId     Int
  amount        BigInt
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  address        String        @unique
  expectedAmount BigInt
  paidAmount     BigInt?
  fromAddress    String?
  currency       String
  network        String
  fee            BigInt?
  status         InvoiceStatus @default(PENDING)
  expiresAt      DateTime
  txHash         String?
  logIndex       Int?
  createdAt      DateTime      @default(now())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])

  @@unique([txHash, logIndex])
  @@index([status, expiresAt])
  @@index([userId])
}

enum Type {
  deposit
  withdrawal
}

enum PossibleStatus {
  pending
  confirmed
}

enum AccountType {
  USER
  SYSTEM
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  EXPIRED_PAID
  MANUAL_REVIEW
}
