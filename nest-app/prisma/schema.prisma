generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  wallets      Wallet[]
  invoices     Invoice[]
}

model Wallet {
  publicId     String        @unique @default(uuid())
  id           Int           @id @default(autoincrement())
  address      String
  currency     String
  network      String
  createdAt    DateTime      @default(now())
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  account      Account?

  @@index([userId])
}

model Transaction {
  publicId        String         @default(uuid())
  id              Int            @id @default(autoincrement())
  transactionHash String?        @unique
  idempotencyKey  String?        @unique
  type            Type
  amount          BigInt
  createdAt       DateTime       @default(now())
  status          PossibleStatus @default(pending)
  walletId        Int
  wallet          Wallet         @relation(fields: [walletId], references: [id])
  entries         LedgerEntry[]

  @@index([walletId])
}

model Account {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  type      AccountType
  currency  String
  network   String
  walletId  Int?          @unique
  wallet    Wallet?       @relation(fields: [walletId], references: [id])
  entries   LedgerEntry[]
}

// checking movement details of the transaction , THE VIEW FROM USER/SYSTEM BALANCES
// => give strict understantion about all balance history
model LedgerEntry {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  transactionId Int
  accountId     Int
  amount        BigInt
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Invoice {
  id        Int           @id @default(autoincrement())
  address   String
  amount    BigInt
  currency  String
  network   String
  status    InvoiceStatus @default(PENDING)
  expiresAt DateTime
  txHash    String?       @unique
  createdAt DateTime      @default(now())
  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  @@index([status, expiresAt])
  @@index([userId])
}

enum Type {
  deposit
  withdrawal
}

enum PossibleStatus {
  pending
  confirmed
}

enum AccountType {
  USER
  SYSTEM
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  EXPIRED_PAID
}
